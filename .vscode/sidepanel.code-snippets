{
  // SidebarApp Multi-Controller Pattern
  "sidebar-app": {
    "prefix": "sidebar-app",
    "body": [
      "class ${1:Name}Controller {",
      "  constructor() {",
      "    this.data = [];",
      "  }",
      "",
      "  init() {",
      "    this.bindEvents();",
      "    this.loadData();",
      "  }",
      "",
      "  onShow() {",
      "    this.loadData();",
      "  }",
      "",
      "  loadData() {",
      "    // Override in subclass",
      "  }",
      "",
      "  bindEvents() {",
      "    // Bind event listeners",
      "  }",
      "}",
      "",
      "class SidebarApp {",
      "  constructor() {",
      "    this.controllers = {};",
      "    this.currentPage = '${2:defaultPage}';",
      "  }",
      "",
      "  async init() {",
      "    this.controllers.page1 = new ${1:Name}Controller();",
      "    this.controllers.page1.init();",
      "    this.bindNavigation();",
      "  }",
      "",
      "  bindNavigation() {",
      "    document.querySelectorAll('.nav-btn').forEach(btn =>",
      "      btn.addEventListener('click', () => this.switchPage(btn.dataset.page))",
      "    );",
      "  }",
      "",
      "  switchPage(pageName) {",
      "    document.querySelectorAll('.nav-btn').forEach(btn =>",
      "      btn.classList.toggle('active', btn.dataset.page === pageName)",
      "    );",
      "    document.querySelectorAll('.page').forEach(p =>",
      "      p.classList.toggle('active', p.id === `page-\\${pageName}`)",
      "    );",
      "    this.currentPage = pageName;",
      "    const controller = this.controllers[pageName];",
      "    if (controller?.onShow) controller.onShow();",
      "  }",
      "}"
    ],
    "description": "Sidebar multi-controller app pattern"
  },

  // sendMessage Wrapper Pattern
  "send-message": {
    "prefix": "send-message",
    "body": [
      "sendMessage(message) {",
      "  return new Promise((resolve) => {",
      "    chrome.runtime.sendMessage(message, (response) =>",
      "      resolve(response || {})",
      "    );",
      "  });",
      "}"
    ],
    "description": "Promise-based chrome.runtime.sendMessage wrapper"
  },

  // Dropdown Toggle Pattern
  "dropdown-toggle": {
    "prefix": "dropdown-toggle",
    "body": [
      "// Toggle dropdown",
      "toggleDropdown() {",
      "  const dropdown = document.getElementById('${1:dropdownId}');",
      "  if (dropdown.style.display === 'none') {",
      "    this.renderDropdown();",
      "    dropdown.style.display = 'block';",
      "  } else {",
      "    this.hideDropdown();",
      "  }",
      "}",
      "",
      "hideDropdown() {",
      "  const dropdown = document.getElementById('${1:dropdownId}');",
      "  if (dropdown) dropdown.style.display = 'none';",
      "}",
      "",
      "// Bind in constructor:",
      "// document.getElementById('${2:btnId}')?.addEventListener('click', (e) => {",
      "//   e.stopPropagation();",
      "//   this.toggleDropdown();",
      "// });",
      "// document.addEventListener('click', (e) => {",
      "//   if (!e.target.closest('.${3:containerClass}')) {",
      "//     this.hideDropdown();",
      "//   }",
      "// });"
    ],
    "description": "Dropdown toggle with click-outside-to-close pattern"
  },

  // Toast Notification Pattern
  "toast-notification": {
    "prefix": "toast",
    "body": [
      "toast(message, type = 'info') {",
      "  const existing = document.querySelector('.sidebar-toast');",
      "  if (existing) existing.remove();",
      "  const t = document.createElement('div');",
      "  t.className = `sidebar-toast toast-\\${type}`;",
      "  t.textContent = message;",
      "  document.body.appendChild(t);",
      "  requestAnimationFrame(() => t.classList.add('show'));",
      "  setTimeout(() => {",
      "    t.classList.remove('show');",
      "    setTimeout(() => t.remove(), 300);",
      "  }, 2000);",
      "}"
    ],
    "description": "Toast notification with animation"
  },

  // Group by Key Pattern
  "group-by": {
    "prefix": "group-by",
    "body": [
      "getGroupedItems(items) {",
      "  const groups = {};",
      "  items.forEach(i => {",
      "    const key = i.${1:property} || '';",
      "    (groups[key] = groups[key] || []).push(i);",
      "  });",
      "  return groups;",
      "}"
    ],
    "description": "Group array items by property"
  },

  // Filter with Search Pattern
  "filter-search": {
    "prefix": "filter-search",
    "body": [
      "getFilteredItems() {",
      "  return this.items.filter(item => {",
      "    const matchSearch = !this.searchQuery ||",
      "      item.content.toLowerCase().includes(this.searchQuery.toLowerCase()) ||",
      "      item.tag.toLowerCase().includes(this.searchQuery.toLowerCase());",
      "    const matchFilter = !this.currentFilter || this.currentFilter === '__all__' ||",
      "      (this.currentFilter === '__empty__' ? !item.tag : item.tag === this.currentFilter);",
      "    return matchSearch && matchFilter;",
      "  });",
      "}"
    ],
    "description": "Filter items with search and category"
  },

  // Keyboard Navigation Pattern
  "keyboard-nav": {
    "prefix": "keyboard-nav",
    "body": [
      "// In bindEvents:",
      "document.addEventListener('keydown', (e) => {",
      "  if (!this.isActive()) return;",
      "  if (e.key === 'ArrowDown') {",
      "    e.preventDefault();",
      "    this.selectedIndex = (this.selectedIndex + 1) % this.filteredItems.length;",
      "    this.render();",
      "    this.scrollToSelected();",
      "  } else if (e.key === 'ArrowUp') {",
      "    e.preventDefault();",
      "    this.selectedIndex = this.selectedIndex <= 0 ?",
      "      this.filteredItems.length - 1 : this.selectedIndex - 1;",
      "    this.render();",
      "    this.scrollToSelected();",
      "  } else if (e.key === 'Enter') {",
      "    e.preventDefault();",
      "    this.openSelected();",
      "  }",
      "});"
    ],
    "description": "Keyboard navigation with arrow keys"
  },

  // Import Export Pattern
  "import-export": {
    "prefix": "import-export-json",
    "body": [
      "// Export",
      "export() {",
      "  const blob = new Blob([JSON.stringify(this.data, null, 2)], { type: 'application/json' });",
      "  const a = document.createElement('a');",
      "  a.href = URL.createObjectURL(blob);",
      "  a.download = `export-\\${new Date().toISOString().slice(0, 10)}.json`;",
      "  a.click();",
      "}",
      "",
      "// Import",
      "showImport() {",
      "  const input = document.createElement('input');",
      "  input.type = 'file';",
      "  input.accept = '.json';",
      "  input.onchange = async (e) => {",
      "    const file = e.target.files[0];",
      "    if (!file) return;",
      "    try {",
      "      const text = await file.text();",
      "      const data = JSON.parse(text);",
      "      // Handle imported data",
      "      this.save();",
      "      this.render();",
      "      this.toast('Import successful', 'success');",
      "    } catch {",
      "      this.toast('Import failed', 'error');",
      "    }",
      "  };",
      "  input.click();",
      "}"
    ],
    "description": "JSON import/export with file picker"
  },

  // Modal Dialog Pattern
  "modal-dialog": {
    "prefix": "modal-dialog",
    "body": [
      "showEditDialog(item) {",
      "  const existing = document.getElementById('editDialog');",
      "  if (existing) existing.remove();",
      "  const dialog = document.createElement('div');",
      "  dialog.id = 'editDialog';",
      "  dialog.className = 'dialog-overlay';",
      "  dialog.innerHTML = `<div class=\"dialog\">",
      "    <div class=\"dialog-header\">",
      "      <h3>Edit</h3>",
      "      <button class=\"dialog-close\">&times;</button>",
      "    </div>",
      "    <div class=\"dialog-body\">",
      "      <div class=\"field\"><label>Field</label><input id=\"editField\" value=\"\\${this.esc(item.field)}\"></div>",
      "    </div>",
      "    <div class=\"dialog-footer\">",
      "      <button class=\"btn-cancel\">Cancel</button>",
      "      <button class=\"btn-save\">Save</button>",
      "    </div>",
      "  </div>`;",
      "  document.body.appendChild(dialog);",
      "  const close = () => dialog.remove();",
      "  dialog.querySelector('.dialog-close').addEventListener('click', close);",
      "  dialog.querySelector('.btn-cancel').addEventListener('click', close);",
      "  dialog.querySelector('.btn-save').addEventListener('click', () => {",
      "    item.field = document.getElementById('editField').value.trim();",
      "    this.save();",
      "    close();",
      "  });",
      "  dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });",
      "}"
    ],
    "description": "Modal dialog for editing"
  },

  // Event Delegation Pattern
  "event-delegation": {
    "prefix": "event-delegate",
    "body": [
      "bindItemEvents() {",
      "  const list = document.getElementById('${1:listId}');",
      "  list.querySelectorAll('.${2:item-class}').forEach(el => {",
      "    el.addEventListener('click', (e) => {",
      "      const btn = e.target.closest('.${3:action-btn}');",
      "      if (btn) {",
      "        e.stopPropagation();",
      "        this.handleAction(btn.dataset.id);",
      "        return;",
      "      }",
      "      this.handleItemClick(el.dataset.id);",
      "    });",
      "  });",
      "}"
    ],
    "description": "Event delegation for dynamic lists"
  },

  // HTML Escape Pattern
  "html-escape": {
    "prefix": "esc-html",
    "body": [
      "esc(t) {",
      "  if (!t) return '';",
      "  const d = document.createElement('div');",
      "  d.textContent = t;",
      "  return d.innerHTML;",
      "}"
    ],
    "description": "HTML escape utility"
  }
}
