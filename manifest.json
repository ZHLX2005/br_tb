{
  "manifest_version": 3,
  "name": "TabBoard - 标签页分组管理",
  "version": "1.4",
  "description": "类似 OneTab 的标签页分组管理工具，支持快捷键快速收集和分组管理，支持侧边栏显示和表单收集",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "bookmarks",
    "search"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://47.110.80.47/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/videoFrameCapture.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/videoTracker.js", "content/videoSpeed.js", "content/content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/courseProgressBar.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/shared/ring-order.js",
        "content/shared/draggable-ring.js",
        "content/lcSidebar.js",
        "content/vpSidebar.js",
        "content/timerSidebar.js",
        "content/captureRing.js",
        "content/speedRing.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/noteRing.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/inject/goto/goto.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TabBoard - 标签页管理"
  },
  "commands": {
    "add-current-tab": {
      "description": "切换当前标签页在默认分组中的状态（已存在则移除）",
      "suggested_key": {
        "default": "Alt+Shift+A"
      }
    },
    "collect-all-tabs": {
      "description": "收集当前窗口所有标签页",
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    },
    "open-tabboard": {
      "description": "打开标签页管理看板",
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    },
    "focus-search": {
      "description": "打开专注搜索浮层",
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "modules/tabboard/tabboard.html",
        "modules/recording/recording.html",
        "modules/video-progress/video-progress.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  }
}
