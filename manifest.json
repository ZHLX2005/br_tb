{
  "manifest_version": 3,
  "name": "浏览器插件的案例demo",
  "version": "1.0",
  "description": "浏览器插件的案例demo",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "bookmarks",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/lib/katex.min.js", "content/lib/marked.min.js", "content/content.js", "content/content-ocr.js"],
      "css": ["content/content.css", "content/content-ocr.css", "content/lib/katex.min.css"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "划词翻译"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "modules/favorites/favorites.html",
        "modules/favorites/favorites.js",
        "modules/browser-bookmarks/browser-bookmarks.html",
        "modules/browser-bookmarks/browser-bookmarks.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
