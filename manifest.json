{
  "manifest_version": 3,
  "name": "TabBoard - 标签页分组管理",
  "version": "1.4",
  "description": "类似 OneTab 的标签页分组管理工具，支持快捷键快速收集和分组管理，支持侧边栏显示和表单收集",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TabBoard - 标签页管理"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "add-current-tab": {
      "description": "添加当前标签页到默认分组",
      "suggested_key": {
        "default": "Alt+Shift+A"
      }
    },
    "collect-all-tabs": {
      "description": "收集当前窗口所有标签页",
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    },
    "collect-other-tabs": {
      "description": "收集除了当前页面外的其他所有标签页",
      "suggested_key": {
        "default": "Alt+Shift+X"
      }
    },
    "open-tabboard": {
      "description": "打开标签页管理看板",
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "modules/tabboard/tabboard.html",
        "sidepanel/sidepanel.html",
        "sidepanel/sidepanel.js",
        "sidepanel/sidepanel.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  }
}
